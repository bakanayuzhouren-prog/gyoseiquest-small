{
  "name": "gyosei-quest-small",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "dev": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:questions": "node scripts/convertQuestions.js",
    "sync:questions": "node scripts/syncQuiz.js",
    "sync:learn": "node scripts/syncLearn.js",
    "export:knowledge-md": "node scripts/exportKnowledgeMd.mjs",
    "sync:knowledge": "npm run export:knowledge-md && npm run build:chat-md-index",
    "sync:all": "npm run sync:questions && npm run sync:learn && npm run sync:knowledge",
    "build:chat-md-index": "node scripts/buildChatMarkdownChunks.js",
    "check:chat-briefs": "node --experimental-strip-types scripts/checkChatTopicBriefs.mjs",
    "build:goukaku-round3-chat": "node scripts/buildGoukakuRound3ChatBriefs.mjs",
    "bundle:teitouken-textbook": "node scripts/bundleTeitoukenTextbook.js",
    "bundle:shouhou-textbook": "node scripts/bundleShouhouTextbook.mjs",
    "bundle:kenpou-textbook": "node scripts/bundleKenpouTextbook.mjs",
    "bundle:kenpou-textbook-from-learn": "node scripts/bundleKenpouTextbookFromLearn.mjs",
    "extract:teitouken-pdf": "node scripts/extractTeitoukenPdf.js",
    "sync:sheets": "node scripts/sync-spreadsheet.js",
    "generate:descriptive-images": "node scripts/generateDescriptiveImages.js",
    "generate:deepdive-images": "node scripts/generateDeepdiveImages.js",
    "sync:saikensouron-images": "node scripts/syncSaikensouronLearnImages.mjs && node scripts/generateDeepdiveImages.js",
    "sync:kenpou-deepdive": "node scripts/syncKenpouDeepdiveFromTemp.js",
    "sync:quiz-deepdive": "node scripts/syncQuizDeepdiveFromTemp.mjs",
    "import:moshi": "node scripts/importMoshiFromLocalImages.mjs",
    "import:tac-zips": "node scripts/importTacZipsFromDownloads.mjs",
    "build:moshi-topics": "node scripts/buildMoshiTopicLearning.mjs",
    "build:moshi-topics:round3": "node scripts/buildMoshiTopicLearning.mjs data/moshi/goukaku-kakumei-round3-topics.json --round=第3回",
    "build:tac-topics": "node scripts/tmpExtractTacSources.mjs && node scripts/buildTacTopicLearning.mjs",
    "build:tac2-topics": "node scripts/buildTac2TopicLearning.mjs",
    "read:moshi-marksheet": "node scripts/readMoshiMarkSheet.mjs",
    "extract:ito-juku": "node scripts/_extractItoJukuPdfs.js",
    "build:ito-juku-md": "node scripts/_buildItoJukuKnowledgeMd.js",
    "sync:ito-juku": "npm run extract:ito-juku && npm run build:ito-juku-md && npm run build:chat-md-index",
    "inject:kenpou-deepdive-tags": "node scripts/injectKenpouDeepdiveImages.js",
    "compress:temp-kenpou": "node scripts/compressTempKenpouImages.mjs",
    "downscale:assets": "node scripts/downscaleAppAssets.mjs",
    "downscale:assets:dry": "node scripts/downscaleAppAssets.mjs --dry-run"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "canvas": "^3.2.1",
    "csv-parser": "^3.0.0",
    "dotenv": "^17.2.3",
    "expo": "~54.0.30",
    "expo-constants": "~18.0.12",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.21",
    "expo-speech": "^14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "googleapis": "^169.0.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.4.624",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "0.5.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "patch-package": "^8.0.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
