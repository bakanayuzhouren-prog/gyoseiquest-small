# Google Sheets API設定
# 1. https://console.cloud.google.com/ にアクセス
# 2. プロジェクトを作成（または既存のプロジェクトを選択）
# 3. 「APIとサービス」→「ライブラリ」→「Google Sheets API」を有効化
# 4. 「認証情報」→「認証情報を作成」→「APIキー」を選択
# 5. 生成されたAPIキーを以下にコピー

GOOGLE_SHEETS_API_KEY=your_api_key_here
# セルへ書くときだけ使う。APIキーでは書けない。JSONはGitHubへ上げない。
GOOGLE_APPLICATION_CREDENTIALS=credentials/sheets-writer.json
# 行政法総論等を含むメインスプレッドシート
SHEET_ID=17JnEROPXhPt6j7DmmwTHDlFilMirhd9bnpOJ7gBixxs
# 行政法総論はシート「行政法総論」または「行政法１（ここに全部入ってる）」から取得
# テスター名簿。問題の同期（SHEET_ID）とは別。sync:questions は読まない。
# 1行目: A=ユーザーNO（000001から連番） / B=ID（6桁ランダム） / C=PW / D=ユーザー名 / E=アバター
ID_LIST_SHEET_ID=1gVlMtGItzLG509PfaHiq9YEZZJivr9C5662IX6uzxWQ
